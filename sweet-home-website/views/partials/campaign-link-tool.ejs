<%
  const campaignUser = typeof user !== 'undefined' && user &&
    ['Admin', 'SuperAdmin'].includes(user.role);
  const isStandalone = typeof standalone !== 'undefined' && standalone === true;
  const toolType = typeof pageType !== 'undefined' && pageType ? pageType : 'page';
  const toolSlug = typeof pageSlug !== 'undefined' && pageSlug ? pageSlug : '';
%>
<% if (campaignUser || isStandalone) { %>
  <link rel="stylesheet" href="/css/campaign-links.css?v=1" />

  <% if (!isStandalone) { %>
    <button type="button" class="btn campaign-link-trigger" data-campaign-open>
      <span class="campaign-link-trigger__icon" aria-hidden="true">↗</span>
      Create campaign link
    </button>
  <% } %>

  <% if (!isStandalone) { %>
    <div class="campaign-link-modal" data-campaign-modal aria-hidden="true">
      <div class="campaign-link-dialog" role="dialog" aria-modal="true" aria-labelledby="campaign-link-title">
        <button type="button" class="campaign-link-close" data-campaign-close aria-label="Close">×</button>
        <div class="campaign-link-dialog__heading">
          <span class="campaign-link-eyebrow">Share a tracked link</span>
          <h2 id="campaign-link-title">Create campaign link</h2>
          <p>Use this link in your email or social post so new leads can be attributed correctly.</p>
        </div>
  <% } %>

  <form class="campaign-link-tool <%= isStandalone ? 'campaign-link-tool--page' : '' %>"
        data-campaign-form
        data-campaign-kind="<%= toolType %>"
        data-campaign-default="<%= toolSlug %>">
    <% if (isStandalone) { %>
      <div class="campaign-link-page-intro">
        <span class="campaign-link-eyebrow">Campaign tools</span>
        <h1>Campaign link builder</h1>
        <p>Create ready-to-use tracked links for property, project, email and social campaigns.</p>
      </div>
      <div class="campaign-link-field">
        <label for="campaign-page-url">Page URL</label>
        <input id="campaign-page-url" type="url" required data-campaign-base-url
               placeholder="https://sweethome-immobilien.de/properties/..." />
        <small>Paste the public page you want to share.</small>
      </div>
    <% } else { %>
      <div class="campaign-link-context">
        <span class="campaign-link-eyebrow">Current page</span>
        <strong><%= pageTitle || 'Property page' %></strong>
      </div>
    <% } %>

    <div class="campaign-link-fields">
      <div class="campaign-link-field">
        <label for="campaign-source-<%= toolType %>">Where will you share it?</label>
        <select id="campaign-source-<%= toolType %>" data-campaign-source required>
          <option value="email">Email</option>
          <option value="instagram">Instagram</option>
          <option value="facebook">Facebook</option>
          <option value="whatsapp">WhatsApp</option>
          <option value="linkedin">LinkedIn</option>
          <option value="google">Google Ads</option>
          <option value="other">Other</option>
        </select>
      </div>

      <div class="campaign-link-field">
        <label for="campaign-name-<%= toolType %>">Campaign name</label>
        <input id="campaign-name-<%= toolType %>" type="text" required
               data-campaign-name maxlength="100" placeholder="e.g. summer_2026" />
        <small>Use a short name you will recognise in the leads dashboard.</small>
      </div>

      <div class="campaign-link-field">
        <label for="campaign-content-<%= toolType %>">CTA or placement</label>
        <select id="campaign-content-<%= toolType %>" data-campaign-content>
          <option value="main_cta">Main CTA</option>
          <option value="email_button">Email button</option>
          <option value="social_post">Social post</option>
          <option value="whatsapp">WhatsApp message</option>
          <option value="footer_cta">Footer CTA</option>
          <option value="other">Other</option>
        </select>
      </div>
    </div>

    <div class="campaign-link-result" data-campaign-result-wrap hidden>
      <label for="campaign-generated-link-<%= toolType %>">Your tracked link</label>
      <div class="campaign-link-result__row">
        <input id="campaign-generated-link-<%= toolType %>" type="text"
               data-campaign-result readonly />
        <button type="button" class="btn campaign-link-copy" data-campaign-copy>Copy</button>
      </div>
      <p class="campaign-link-status" data-campaign-status aria-live="polite"></p>
    </div>

    <div class="campaign-link-actions">
      <button type="submit" class="btn btn-primary">Generate link</button>
      <button type="button" class="btn btn-light" data-campaign-share hidden>Share</button>
    </div>
  </form>

  <% if (!isStandalone) { %>
      </div>
    </div>
  <% } %>

  <script src="/js/campaign-links.js?v=1" defer></script>
<% } %>
