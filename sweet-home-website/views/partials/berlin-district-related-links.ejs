<%
  const pageLang = (typeof districtPageLang !== 'undefined' && districtPageLang)
    ? String(districtPageLang).slice(0, 2)
    : 'de';
  const isEn = pageLang === 'en';
  const berlinRelatedDistricts = {
    'Charlottenburg': ['Moabit', 'Schöneberg', 'Prenzlauer Berg'],
    'Moabit': ['Charlottenburg', 'Wedding', 'Kreuzberg'],
    'Friedrichshain-Kreuzberg': ['Kreuzberg', 'Prenzlauer Berg', 'Neukölln'],
    'Schöneberg': ['Charlottenburg', 'Tempelhof', 'Kreuzberg'],
    'Prenzlauer Berg': ['Wedding', 'Friedrichshain-Kreuzberg', 'Charlottenburg'],
    'Wedding': ['Moabit', 'Prenzlauer Berg', 'Reinickendorf'],
    'Tempelhof': ['Schöneberg', 'Neukölln', 'Kreuzberg'],
    'Neukölln': ['Kreuzberg', 'Tempelhof', 'Friedrichshain-Kreuzberg'],
    'Reinickendorf': ['Wedding', 'Spandau', 'Moabit'],
    'Kreuzberg': ['Neukölln', 'Friedrichshain-Kreuzberg', 'Schöneberg'],
    'Spandau': ['Charlottenburg', 'Reinickendorf', 'Moabit'],
    'Mitte': ['Prenzlauer Berg', 'Charlottenburg', 'Kreuzberg'],
    'Pankow': ['Prenzlauer Berg', 'Wedding', 'Reinickendorf']
  };
  const districtLandings = (typeof BERLIN_DISTRICT_LANDINGS !== 'undefined' && Array.isArray(BERLIN_DISTRICT_LANDINGS))
    ? BERLIN_DISTRICT_LANDINGS
    : [];
  const berlinDistrictHrefs = {};
  districtLandings.forEach(function (d) {
    berlinDistrictHrefs[d.displayName] = isEn ? d.enPath : d.dePath;
  });
  const currentDistrictName = (typeof districtDisplayName !== 'undefined' && districtDisplayName)
    ? String(districtDisplayName)
    : '';
  const currentNeighborhood = (typeof defaultNeighborhood !== 'undefined' && defaultNeighborhood)
    ? String(defaultNeighborhood)
    : currentDistrictName;
  const relatedNames = (berlinRelatedDistricts[currentDistrictName] || ['Charlottenburg', 'Prenzlauer Berg', 'Kreuzberg'])
    .filter(function(name){ return name !== currentDistrictName && berlinDistrictHrefs[name]; })
    .slice(0, 3);
  const berlinHubHref = isEn ? '/en/properties-for-sale-berlin' : '/wohnungen-berlin-kaufen';
  const berlinSearchHref = ((typeof localePath === 'function') ? localePath('/properties/for-sale/germany/berlin') : '/properties/for-sale/germany/berlin')
    + '?neighborhood=' + encodeURIComponent(currentNeighborhood);
  const ratgeberLinks = (typeof getDistrictRatgeberLinks === 'function')
    ? getDistrictRatgeberLinks(currentDistrictName, pageLang)
    : [];
  const ratgeberTitle = isEn ? 'Guides for buying an apartment' : 'Ratgeber zum Wohnungskauf';
  const ratgeberIntro = isEn
    ? ('Practical Sweet Home Berlin guides — especially useful if you are buying or comparing in ' + currentDistrictName + '.')
    : ('Passende Guides von Sweet Home Berlin — speziell hilfreich, wenn Sie in ' + currentDistrictName + ' kaufen oder vergleichen möchten.');
  const relatedTitle = isEn ? 'Explore more Berlin districts' : 'Weitere Berliner Bezirke entdecken';
  const relatedIntro = isEn
    ? ('Compare ' + currentDistrictName + ' with nearby areas, or return to the Berlin overview.')
    : ('Vergleichen Sie ' + currentDistrictName + ' mit nahegelegenen Lagen oder kehren Sie zur Berlin-Übersicht zurück.');
  const berlinHubLabel = isEn ? 'Apartments for sale in Berlin' : 'Wohnungen in Berlin kaufen';
  const currentOffersLabel = isEn
    ? ('Current listings in ' + currentDistrictName)
    : ('Aktuelle Angebote in ' + currentDistrictName);
  const relatedDistrictLabel = function (name) {
    return isEn ? ('Apartments for sale in ' + name) : ('Wohnung kaufen ' + name);
  };
%>
<% if (ratgeberLinks.length > 0) { %>
<section class="berlin-content section berlin-district-ratgeber" aria-labelledby="district-ratgeber-heading">
  <div class="berlin-content__inner">
    <h2 id="district-ratgeber-heading" class="berlin-content__title"><%= ratgeberTitle %></h2>
    <p class="berlin-content__intro"><%= ratgeberIntro %></p>
    <ul class="berlin-ratgeber-cards">
      <% ratgeberLinks.forEach(function(link) {
        const cardHref = link.href;
        const coverSrc = link.cover || '/images/berlin-hero.jpg';
      %>
        <li class="berlin-ratgeber-card">
          <a class="berlin-ratgeber-card__media" href="<%= cardHref %>" tabindex="-1" aria-hidden="true">
            <img src="<%= coverSrc %>" alt="" loading="lazy" decoding="async" width="640" height="400">
          </a>
          <a class="berlin-ratgeber-card__title" href="<%= cardHref %>"><%= link.anchor %></a>
        </li>
      <% }); %>
    </ul>
  </div>
</section>
<% } %>
<section class="berlin-content section berlin-best-areas" aria-labelledby="district-internal-links-heading">
  <div class="berlin-content__inner">
    <h2 id="district-internal-links-heading" class="berlin-content__title"><%= relatedTitle %></h2>
    <p class="berlin-content__intro"><%= relatedIntro %></p>
    <ul class="berlin-areas__list">
      <li class="berlin-areas__item"><a href="<%= berlinHubHref %>"><%= berlinHubLabel %></a></li>
      <li class="berlin-areas__item"><a href="<%= berlinSearchHref %>"><%= currentOffersLabel %></a></li>
      <% relatedNames.forEach(function(name){ %>
        <li class="berlin-areas__item"><a href="<%= berlinDistrictHrefs[name] %>"><%= relatedDistrictLabel(name) %></a></li>
      <% }); %>
    </ul>
  </div>
</section>
