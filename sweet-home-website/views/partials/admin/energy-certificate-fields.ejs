<%
  const energy = (typeof values !== 'undefined' && values) ? values : {};
  let selectedSources = energy.energy_sources || [];
  if (typeof selectedSources === 'string') selectedSources = selectedSources ? [selectedSources] : [];
  if (!Array.isArray(selectedSources)) selectedSources = [];
  const energyType = energy.energy_certificate_type || '';
  const showDetails = energyType === 'demand' || energyType === 'consumption';
  function bilingual(row) {
    return row.en === row.de ? row.en : (row.en + ' (' + row.de + ')');
  }
%>
<section class="card" id="energyCertificateSection">
  <h2>Energy Certificate (Energieausweis)<span class="req">*</span></h2>
  <p class="energy-lead">Start with the certificate type. Performance, heating, and the PDF open when the type is a demand or consumption certificate.</p>

  <div class="energy-block">
    <h3>Certificate type</h3>
    <div class="field energy-type-field">
      <label for="energy_certificate_type">Energy Certificate Type (Energieausweistyp)<span class="req">*</span></label>
      <select id="energy_certificate_type" name="energy_certificate_type" required>
        <option value="">Select</option>
        <% energyCertificate.CERTIFICATE_TYPES.forEach(function (row) { %>
          <option value="<%= row.value %>" <%= energyType === row.value ? 'selected' : '' %>><%= bilingual(row) %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <div id="energyDetails" <%= showDetails ? '' : 'hidden' %>>
    <div class="energy-block">
      <h3>Performance</h3>
      <p class="energy-block-note">The figures and the construction year printed on the certificate. This year is separate from Year Built.</p>
      <div class="grid-2">
        <div class="field">
          <label for="energy_value">
            <span id="energyValueText"><%= energyType === 'consumption' ? 'Final energy consumption (Endenergieverbrauch)' : 'Final energy demand (Endenergiebedarf)' %></span>
            <span class="req">*</span>
          </label>
          <input
            id="energy_value"
            name="energy_value"
            type="number"
            min="0"
            max="999999.99"
            step="0.01"
            inputmode="decimal"
            data-energy-required="1"
            data-demand-label="Final energy demand (Endenergiebedarf)"
            data-consumption-label="Final energy consumption (Endenergieverbrauch)"
            value="<%= energy.energy_value != null && energy.energy_value !== '' ? energy.energy_value : '' %>"
          />
          <small class="field-hint">kWh/(m²·a)</small>
        </div>
        <div class="field">
          <label for="energy_efficiency_class">Energy efficiency class (Energieeffizienzklasse)<span class="req">*</span></label>
          <select id="energy_efficiency_class" name="energy_efficiency_class" data-energy-required="1">
            <option value="">Select</option>
            <% energyCertificate.EFFICIENCY_CLASSES.forEach(function (klass) { %>
              <option value="<%= klass %>" <%= String(energy.energy_efficiency_class || '') === klass ? 'selected' : '' %>><%= klass %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="field energy-year-field">
        <label for="energy_certificate_year">Construction year according to the energy certificate (Baujahr laut Energieausweis)<span class="req">*</span></label>
        <input
          id="energy_certificate_year"
          name="energy_certificate_year"
          type="number"
          min="1800"
          max="<%= new Date().getFullYear() %>"
          step="1"
          data-energy-required="1"
          value="<%= energy.energy_certificate_year || '' %>"
        />
      </div>
    </div>

    <div class="energy-block">
      <h3>Heating</h3>
      <p class="energy-block-note">Heating type first, then every main energy source named on the certificate.</p>
      <div class="field energy-type-field">
        <label for="heating_type">Heating Type (Heizungsart)<span class="req">*</span></label>
        <select id="heating_type" name="heating_type" data-energy-required="1">
          <option value="">Select</option>
          <% energyCertificate.HEATING_TYPES.forEach(function (row) { %>
            <option value="<%= row.value %>" <%= String(energy.heating_type || '') === row.value ? 'selected' : '' %>><%= bilingual(row) %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label>Main energy sources (Wesentliche Energieträger)<span class="req">*</span></label>
        <div class="chips" id="energySources">
          <% energyCertificate.ENERGY_SOURCES.forEach(function (row) { %>
            <label class="chip">
              <input type="checkbox" name="energy_sources" value="<%= row.value %>" <%= selectedSources.indexOf(row.value) !== -1 ? 'checked' : '' %> />
              <span><%= bilingual(row) %></span>
            </label>
          <% }) %>
        </div>
        <small class="field-hint">No information clears the other sources.</small>
      </div>
    </div>

    <%
      const energyPdfUrl = energy.energy_certificate_pdf || '';
      let energyPdfName = '';
      if (energyPdfUrl) {
        const rawName = String(energyPdfUrl).split('?')[0].split('/').pop() || 'energy-certificate.pdf';
        try { energyPdfName = decodeURIComponent(rawName).replace(/^\d+-/, ''); }
        catch (e) { energyPdfName = rawName; }
      }
    %>
    <div class="energy-block energy-pass-field">
      <h3>Energy pass</h3>
      <p class="energy-block-note">Optional PDF of the certificate. You can replace or remove it here.</p>
      <label class="energy-pass-label" for="energy_certificate_pdf">Energy certificate PDF (Energieausweis PDF)</label>
      <div class="energy-pass" id="energyPass" data-existing-url="<%= energyPdfUrl %>" data-existing-name="<%= energyPdfName %>">
        <input id="energy_certificate_pdf" name="energy_certificate_pdf" type="file" accept="application/pdf,.pdf" />
        <input type="hidden" id="remove_existing_energy_pdf" name="remove_existing_energy_pdf" value="false" />
        <button type="button" class="energy-pass-drop" id="energyPassDrop" <%= energyPdfUrl ? 'hidden' : '' %>>
          <span class="energy-pass-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z"></path>
              <path d="M14 2v5h5"></path>
              <path d="M12 18v-6"></path>
              <path d="M9.5 14.5 12 12l2.5 2.5"></path>
            </svg>
          </span>
          <span class="energy-pass-drop-copy">
            <strong>Upload the energy pass</strong>
            <small>Drop a PDF here, or click to browse. Maximum 20 MB.</small>
          </span>
        </button>
        <div class="energy-pass-file" id="energyPassFile" <%= energyPdfUrl ? '' : 'hidden' %>>
          <span class="energy-pass-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z"></path>
              <path d="M14 2v5h5"></path>
              <path d="M8 13h8"></path>
              <path d="M8 17h5"></path>
            </svg>
          </span>
          <div class="energy-pass-meta">
            <strong id="energyPassName"><%= energyPdfName %></strong>
            <small id="energyPassNote"><%= energyPdfUrl ? 'Saved on this listing' : '' %></small>
          </div>
          <div class="energy-pass-actions">
            <a id="energyPassOpen" href="<%= energyPdfUrl %>" target="_blank" rel="noopener noreferrer" <%= energyPdfUrl ? '' : 'hidden' %>>Open</a>
            <button type="button" id="energyPassReplace">Replace</button>
            <button type="button" id="energyPassRemove">Remove</button>
          </div>
        </div>
      </div>
      <small class="field-hint" id="energyPassError" hidden></small>
    </div>
  </div>
</section>
<style>
  #energyCertificateSection .energy-lead {
    margin: -4px 0 16px;
    color: #64748b;
    font-size: 13px;
    line-height: 1.45;
  }
  #energyDetails {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 14px;
  }
  #energyDetails[hidden] { display: none !important; }
  #energyCertificateSection .energy-block {
    padding: 16px 16px 18px;
    background: #f8fbf9;
    border: 1px solid #e6efe9;
    border-radius: 16px;
  }
  #energyCertificateSection .energy-block h3 {
    margin: 0 0 4px;
    color: #23804b;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  #energyCertificateSection .energy-block h3::after { content: none; }
  #energyCertificateSection .energy-block-note {
    margin: 0 0 14px;
    color: #64748b;
    font-size: 13px;
    line-height: 1.45;
  }
  #energyCertificateSection .energy-block .field + .field,
  #energyCertificateSection .energy-block .grid-2 + .field,
  #energyCertificateSection .energy-block .energy-type-field + .field {
    margin-top: 14px;
  }
  #energyCertificateSection .energy-type-field,
  #energyCertificateSection .energy-year-field { max-width: 520px; }
  #energyCertificateSection .energy-pass-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
  #energyCertificateSection .field-hint { display: block; margin-top: 6px; color: #6b7280; font-size: 12px; }
  #energyPass input[type="file"] { display: none !important; }
  #energyPassDrop {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 156px;
    margin: 0;
    padding: 28px 24px;
    box-sizing: border-box;
    text-align: center;
    appearance: none;
    -webkit-appearance: none;
    background: linear-gradient(180deg, #f7fcf9 0%, #ffffff 70%);
    color: #111111;
    border: 1.5px dashed #8ed4aa;
    border-radius: 16px;
    box-shadow: none;
    cursor: pointer;
    font-family: inherit;
    line-height: 1.4;
    transition: border-color .16s ease, background .16s ease, transform .16s ease;
  }
  #energyPassDrop:hover,
  #energyPassDrop.is-dragover {
    border-color: #2ea862;
    background: #f3fbf6;
    transform: translateY(-1px);
  }
  #energyPassFile {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    box-sizing: border-box;
    padding: 14px 16px;
    background: #ffffff;
    border: 1px solid #e6efe9;
    border-radius: 16px;
    box-shadow: 0 8px 20px rgba(35, 128, 75, .06);
  }
  #energyPassDrop[hidden],
  #energyPassFile[hidden],
  #energyPassOpen[hidden] { display: none !important; }
  #energyPass .energy-pass-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    flex: 0 0 auto;
    border-radius: 14px;
    background: #e8f7ee;
    color: #2ea862;
  }
  #energyPassDrop .energy-pass-drop-copy,
  #energyPass .energy-pass-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  #energyPass .energy-pass-meta { flex: 1; text-align: left; }
  #energyPassDrop strong,
  #energyPass .energy-pass-meta strong {
    color: #111111;
    font-size: 15px;
    font-weight: 700;
  }
  #energyPassDrop small,
  #energyPass .energy-pass-meta small {
    color: #64748b;
    font-size: 13px;
    font-weight: 400;
  }
  #energyPass .energy-pass-meta strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #energyPass .energy-pass-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
  }
  #energyPass .energy-pass-actions a,
  #energyPass .energy-pass-actions button {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgba(46, 168, 98, .28);
    background: #ffffff;
    color: #23804b;
    box-shadow: none;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }
  #energyPass .energy-pass-actions a:hover,
  #energyPass .energy-pass-actions button:hover { background: #f3fbf6; }
  #energyPassRemove {
    color: #b30024 !important;
    border-color: #ffd0d8 !important;
    background: #fff7f8 !important;
  }
</style>
