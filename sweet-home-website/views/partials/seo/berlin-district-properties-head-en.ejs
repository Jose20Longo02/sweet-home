<%
  const siteBaseUrl = ((typeof baseUrl !== 'undefined' && baseUrl) ? baseUrl : (process.env.APP_URL || 'https://sweethome.com')).replace(/\/$/, '');
  const pageUrl = (typeof canonicalUrl !== 'undefined' && canonicalUrl) ? canonicalUrl : `${siteBaseUrl}/`;
  const pageDesc = (typeof pageMetaDescription !== 'undefined' && pageMetaDescription) ? pageMetaDescription : 'Discover apartments for sale in Berlin.';
  const pageTitle = (typeof title !== 'undefined' && title) ? title : 'Apartments in Berlin';
  const districtName = (typeof districtDisplayName !== 'undefined' && districtDisplayName) ? districtDisplayName : 'Berlin';
  const pageFaq = (typeof districtContent !== 'undefined' && districtContent && Array.isArray(districtContent.faq)) ? districtContent.faq : [];
  const districtLandings = (typeof BERLIN_DISTRICT_LANDINGS !== 'undefined' && Array.isArray(BERLIN_DISTRICT_LANDINGS)) ? BERLIN_DISTRICT_LANDINGS : [];
  const itemList = districtLandings.map((d, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    url: siteBaseUrl + d.enPath,
    name: 'Apartments for sale in ' + d.displayName
  }));
%>
<meta name="description" content="<%= pageDesc %>">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= pageTitle %> | Sweet Home">
<meta property="og:description" content="<%= pageDesc %>">
<meta property="og:url" content="<%= pageUrl %>">
<meta property="og:image" content="<%= siteBaseUrl %>/images/berlin-hero.jpg">
<meta property="og:image:alt" content="<%= districtName %> – apartments in Berlin">
<meta property="og:site_name" content="Sweet Home">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= pageTitle %> | Sweet Home">
<meta name="twitter:description" content="<%= pageDesc %>">
<meta name="twitter:image" content="<%= siteBaseUrl %>/images/berlin-hero.jpg">

<script type="application/ld+json"><%- (typeof minifyJSON !== 'undefined' ? minifyJSON({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': pageUrl + '#webpage',
      name: pageTitle + ' | Sweet Home',
      description: pageDesc,
      url: pageUrl,
      inLanguage: 'en',
      isPartOf: { '@type': 'WebSite', '@id': siteBaseUrl + '/#website', name: 'Sweet Home' }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteBaseUrl + '/en' },
        { '@type': 'ListItem', position: 2, name: 'Apartments in Berlin', item: siteBaseUrl + '/en/properties-for-sale-berlin' },
        { '@type': 'ListItem', position: 3, name: districtName, item: pageUrl }
      ]
    },
    {
      '@type': 'ItemList',
      name: 'Berlin district pages',
      itemListElement: itemList
    }
  ]
}) : JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': pageUrl + '#webpage',
      name: pageTitle + ' | Sweet Home',
      description: pageDesc,
      url: pageUrl,
      inLanguage: 'en',
      isPartOf: { '@type': 'WebSite', '@id': siteBaseUrl + '/#website', name: 'Sweet Home' }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteBaseUrl + '/en' },
        { '@type': 'ListItem', position: 2, name: 'Apartments in Berlin', item: siteBaseUrl + '/en/properties-for-sale-berlin' },
        { '@type': 'ListItem', position: 3, name: districtName, item: pageUrl }
      ]
    },
    {
      '@type': 'ItemList',
      name: 'Berlin district pages',
      itemListElement: itemList
    }
  ]
})) %></script>
<% if (pageFaq.length) { %>
<script type="application/ld+json"><%- (typeof minifyJSON !== 'undefined' ? minifyJSON({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pageFaq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
}) : JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pageFaq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
})) %></script>
<% } %>
