<% title = 'Furnished apartments' %>
<link rel="stylesheet" href="/css/admin/rentals.css?v=20261113-cards" />
<% if (showSuperadminSidebar) { %>
  <link rel="stylesheet" href="/css/superadmin/manage-properties.css" />
<% } else { %>
  <link rel="stylesheet" href="/css/admin/my-properties.css" />
<% } %>
<% if (showSuperadminSidebar) { %>
<div class="admin-panel">
  <div class="admin-body">
    <%- include('../../partials/superadmin-sidebar', { activePage: 'rentals', pendingCount: pendingCount || 0 }) %>
    <main class="admin-content">
      <section class="properties-container">
        <div class="properties-header">
          <h1>Furnished apartments</h1>
          <div>
            <a href="<%= dashboardPath %>" class="btn btn-secondary">Dashboard</a>
            <a href="<%= rentalBase %>/new" class="btn btn-primary">New apartment</a>
          </div>
        </div>
        <% if (!rentals.length) { %>
          <div class="rental-empty">
            <h2>No apartments yet</h2>
            <p>Add the first furnished apartment. It stays off the catalogue until it is published.</p>
            <a href="<%= rentalBase %>/new" class="btn btn-primary">New apartment</a>
          </div>
        <% } else { %>
          <div class="properties-grid rental-sale-grid">
            <% rentals.forEach(function (rental) { %>
              <div class="property-card">
                <% if (!rental.agent_id) { %>
                  <div class="unassigned-warning">Unassigned</div>
                <% } else { %>
                  <span class="rental-status-chip is-<%= rental.status %>"><%= rental.statusLabel %></span>
                <% } %>
                <img src="<%= rental.agentPicture || '/img/default-avatar.png' %>" class="uploader-thumb" alt="<%= rental.agent_name || 'Agent' %>">
                <div style="position:relative; width:100%;">
                  <img src="<%= rental.cover || '/img/property-placeholder.png' %>" class="thumb" alt="<%= rental.title %>">
                </div>
                <h3><%= rental.title %></h3>
                <p><%= rental.neighborhood || 'Berlin' %><% if (rental.neighborhood) { %>, Berlin<% } %><% if (rental.rentLabel) { %> · <%= rental.rentLabel %>/month<% } %></p>
                <div class="assign-agent">
                  <label for="agent-<%= rental.id %>">Agent in charge:</label>
                  <form action="<%= rentalBase %>/<%= rental.id %>/reassign" method="post" class="reassign-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <select id="agent-<%= rental.id %>" name="agent_id">
                      <% (agents || []).forEach(function (agent) { %>
                        <option value="<%= agent.id %>" <%= Number(rental.agent_id) === Number(agent.id) ? 'selected' : '' %>><%= agent.name || agent.email %></option>
                      <% }) %>
                    </select>
                    <button type="submit" class="reassign-submit">Save</button>
                  </form>
                </div>
                <div class="actions">
                  <form action="<%= rentalBase %>/<%= rental.id %>/delete?_csrf=<%= csrfToken %>" method="post" onsubmit="return confirm('Delete this apartment, its photos, and its video? This cannot be undone.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-danger">Delete</button>
                  </form>
                  <a href="<%= rentalBase %>/<%= rental.id %>/edit" class="btn btn-secondary">Edit</a>
                  <% if (rental.publicPath) { %>
                    <a href="<%= rental.publicPath %>" class="btn btn-secondary">View</a>
                  <% } %>
                  <form action="<%= rentalBase %>/<%= rental.id %>/status" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="status" value="<%= rental.status === 'published' ? 'draft' : 'published' %>">
                    <button type="submit" class="btn btn-secondary"><%= rental.status === 'published' ? 'Unpublish' : 'Publish' %></button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>
    </main>
  </div>
</div>
<% } else { %>
<div class="page-wrap">
  <header class="section-header">
    <h1>Furnished apartments</h1>
    <div class="header-actions">
      <a href="<%= dashboardPath %>" class="link-home">← Return to dashboard</a>
      <a href="<%= rentalBase %>/new" class="btn btn-primary">New apartment</a>
    </div>
  </header>
  <% if (!rentals.length) { %>
    <div class="empty-state">
      <p>No apartments yet. Click <a href="<%= rentalBase %>/new">New apartment</a> to add one.</p>
    </div>
  <% } else { %>
    <div class="cards-grid rental-admin-grid">
      <% rentals.forEach(function (rental) { %>
        <article class="prop-card">
          <div class="flip">
            <div class="front">
              <div class="media">
                <img class="thumb" src="<%= rental.cover || '/img/property-placeholder.png' %>" alt="<%= rental.title %>">
                <div class="badges">
                  <span class="badge badge-status"><%= rental.statusLabel %></span>
                  <% if (rental.video_url) { %><span class="badge badge-status">Video</span><% } %>
                </div>
                <div class="type-badge">Rent</div>
                <div class="price-badge"><%= rental.rentLabel ? rental.rentLabel + ' / mo' : 'Rent on request' %></div>
              </div>
              <div class="content">
                <h3 class="title" title="<%= rental.title %>"><%= rental.title %></h3>
                <p class="meta">
                  <span class="loc-city">Berlin</span>
                  <% if (rental.neighborhood) { %>
                    <span class="dot">•</span>
                    <span class="loc-hood"><%= rental.neighborhood %></span>
                  <% } %>
                </p>
                <div class="quick-specs">
                  <span class="qs-item" title="Rooms">
                    <span class="icon icon-16 icon-inline icon-mask icon-bed" style="color: var(--primary-color);"></span>
                    <%= rental.rooms ?? 0 %>
                  </span>
                  <span class="qs-item" title="Size">
                    <span class="icon icon-16 icon-inline icon-mask icon-size" style="color: var(--primary-color);"></span>
                    <%= rental.sizeLabel || 'n/a' %>
                  </span>
                  <% if (rental.agent_name) { %>
                    <span class="qs-item" title="Agent in charge"><%= rental.agent_name %></span>
                  <% } %>
                </div>
              </div>
            </div>
            <div class="back">
              <div class="stat">
                <span class="stat-num"><%= rental.viewsCount || 0 %></span>
                <span class="stat-label">Views</span>
              </div>
              <div class="stat">
                <span class="stat-num"><%= rental.inquiryCount || 0 %></span>
                <span class="stat-label">Contacts</span>
              </div>
            </div>
          </div>
          <div class="actions">
            <form action="<%= rentalBase %>/<%= rental.id %>/delete?_csrf=<%= csrfToken %>" method="post" onsubmit="return confirm('Delete this apartment, its photos, and its video? This cannot be undone.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-danger">Delete</button>
            </form>
            <a class="btn btn-secondary" href="<%= rentalBase %>/<%= rental.id %>/edit">Edit</a>
            <form action="<%= rentalBase %>/<%= rental.id %>/status" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="status" value="<%= rental.status === 'published' ? 'draft' : 'published' %>">
              <button type="submit" class="btn btn-secondary"><%= rental.status === 'published' ? 'Unpublish' : 'Publish' %></button>
            </form>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</div>
<% } %>
<div id="uploadOverlay" class="upload-overlay" hidden style="display:none;">
  <div class="upload-dialog">
    <div class="upload-spinner"></div>
    <div>
      <div class="upload-title">Uploading...</div>
      <div class="upload-sub">This may take a moment. Please don’t close this page.</div>
    </div>
  </div>
  <style>
    .upload-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.45); display: flex; align-items: center; justify-content: center; z-index: 3000; }
    .upload-dialog { background: #ffffff; border-radius: 12px; padding: 18px 22px; box-shadow: 0 10px 30px rgba(0,0,0,.25); display: flex; align-items: center; gap: 12px; min-width: 280px; }
    .upload-spinner { width: 22px; height: 22px; border: 3px solid #e5e7eb; border-top-color: var(--primary-color); border-radius: 50%; animation: upload-spin 1s linear infinite; }
    .upload-title { font-family: 'Lato', system-ui, -apple-system, Segoe UI, Roboto, sans-serif; font-weight: 600; color: #111; }
    .upload-sub { font-size: 12px; color: #666; margin-top: 2px; }
    @keyframes upload-spin { to { transform: rotate(360deg); } }
  </style>
</div>
<script src="/js/admin-rentals.js?v=20261113-cards"></script>
