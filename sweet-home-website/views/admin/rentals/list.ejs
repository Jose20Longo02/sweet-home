<% title = 'Furnished apartments' %>
<link rel="stylesheet" href="/css/admin/rentals.css?v=20261018-board" />
<div class="admin-panel<%= showSuperadminSidebar ? ' with-sidebar' : '' %>">
  <div class="admin-body">
    <% if (showSuperadminSidebar) { %>
      <%- include('../../partials/superadmin-sidebar', { activePage: 'rentals', pendingCount: pendingCount || 0 }) %>
    <% } %>
    <main class="admin-content rental-board">
      <div class="admin-header">
        <div>
          <h1>Furnished apartments</h1>
          <p class="subtitle">Staff only. These apartments are not on the public site yet.</p>
        </div>
        <div class="header-actions">
          <a href="<%= dashboardPath %>" class="back-home">← Dashboard</a>
          <a href="<%= rentalBase %>/new" class="btn">New apartment</a>
        </div>
      </div>

      <section class="rental-summary" aria-label="Apartment totals">
        <div><strong><%= rentals.length %></strong><span>Apartments</span></div>
        <div><strong><%= rentals.filter(function (rental) { return rental.status === 'published'; }).length %></strong><span>Published</span></div>
        <div><strong><%= rentals.filter(function (rental) { return rental.status !== 'published'; }).length %></strong><span>Drafts</span></div>
      </section>

      <% if (!rentals.length) { %>
        <div class="rental-empty">
          <h2>No apartments yet</h2>
          <p>Add the first furnished apartment. It stays off the public site until a catalogue is published.</p>
          <a href="<%= rentalBase %>/new" class="btn">New apartment</a>
        </div>
      <% } else { %>
        <div class="rental-grid">
          <% rentals.forEach(function (rental) { %>
            <article class="rental-card">
              <a class="rental-media" href="<%= rentalBase %>/<%= rental.id %>/edit">
                <% if (rental.cover) { %>
                  <img src="<%= rental.cover %>" alt="<%= rental.title %>">
                <% } else { %>
                  <span class="rental-cover-empty">No photo</span>
                <% } %>
                <span class="rental-status is-<%= rental.status %>"><%= rental.statusLabel %></span>
                <span class="rental-rent"><%= rental.rentLabel %><small>/ month</small></span>
                <% if (rental.photos.length) { %>
                  <span class="rental-count"><%= rental.photos.length === 1 ? '1 photo' : rental.photos.length + ' photos' %></span>
                <% } %>
              </a>
              <% if (rental.thumbs.length) { %>
                <div class="rental-thumbs">
                  <% rental.thumbs.forEach(function (url) { %>
                    <img src="<%= url %>" alt="">
                  <% }) %>
                  <% if (rental.extraCount) { %>
                    <span class="rental-more">+<%= rental.extraCount %></span>
                  <% } %>
                </div>
              <% } %>
              <div class="rental-body">
                <h2><a href="<%= rentalBase %>/<%= rental.id %>/edit"><%= rental.title %></a></h2>
                <p class="rental-place"><%= rental.neighborhood || 'Berlin' %><% if (rental.neighborhood) { %>, Berlin<% } %></p>
                <ul class="rental-facts">
                  <% if (rental.sizeLabel) { %><li><%= rental.sizeLabel %></li><% } %>
                  <% if (rental.roomsLabel) { %><li><%= rental.roomsLabel %></li><% } %>
                  <% if (rental.floorLabel) { %><li><%= rental.floorLabel %></li><% } %>
                  <li><%= rental.languageLabel %></li>
                </ul>
                <ul class="rental-meta">
                  <% if (rental.depositLabel) { %><li>Deposit <%= rental.depositLabel %></li><% } %>
                  <% if (rental.availableLabel) { %><li>From <%= rental.availableLabel %></li><% } %>
                  <% if (rental.stayLabel) { %><li><%= rental.stayLabel %></li><% } %>
                  <% if (rental.utilitiesLabel) { %><li><%= rental.utilitiesLabel %></li><% } %>
                  <% if (rental.agent_name) { %><li><%= rental.agent_name %></li><% } %>
                </ul>
              </div>
              <div class="rental-actions">
                <a href="<%= rentalBase %>/<%= rental.id %>/edit">Edit</a>
                <form method="post" action="<%= rentalBase %>/<%= rental.id %>/status">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="status" value="<%= rental.status === 'published' ? 'draft' : 'published' %>">
                  <button type="submit"><%= rental.status === 'published' ? 'Unpublish' : 'Publish' %></button>
                </form>
                <form method="post" action="<%= rentalBase %>/<%= rental.id %>/delete?_csrf=<%= csrfToken %>" onsubmit="return confirm('Delete this apartment and its photos? This cannot be undone.')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="danger">Delete</button>
                </form>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </main>
  </div>
</div>
<div id="uploadOverlay" class="upload-overlay" hidden style="display:none;">
  <div class="upload-dialog">
    <div class="upload-spinner"></div>
    <div>
      <div class="upload-title">Uploading...</div>
      <div class="upload-sub">This may take a moment. Please don’t close this page.</div>
    </div>
  </div>
  <style>
    .upload-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.45); display: flex; align-items: center; justify-content: center; z-index: 3000; }
    .upload-dialog { background: #ffffff; border-radius: 12px; padding: 18px 22px; box-shadow: 0 10px 30px rgba(0,0,0,.25); display: flex; align-items: center; gap: 12px; min-width: 280px; }
    .upload-spinner { width: 22px; height: 22px; border: 3px solid #e5e7eb; border-top-color: var(--primary-color); border-radius: 50%; animation: upload-spin 1s linear infinite; }
    .upload-title { font-family: 'Lato', system-ui, -apple-system, Segoe UI, Roboto, sans-serif; font-weight: 600; color: #111; }
    .upload-sub { font-size: 12px; color: #666; margin-top: 2px; }
    @keyframes upload-spin { to { transform: rotate(360deg); } }
  </style>
</div>
<script src="/js/admin-rentals.js"></script>
