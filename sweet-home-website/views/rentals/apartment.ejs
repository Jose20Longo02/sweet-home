<link rel="stylesheet" href="/css/rentals-catalogue.css?v=20261113-video-stage" />
<section class="catalogue apartment">
  <a class="apartment-back" href="<%= cataloguePath %>"><%= lang === 'en' ? 'All furnished apartments' : 'Alle möblierten Wohnungen' %></a>
  <div class="apartment-layout">
    <div>
      <div class="apartment-gallery" data-title="<%= rental.title %>" data-watch="<%= lang === 'en' ? 'Watch the video' : 'Video ansehen' %>" data-play="<%= lang === 'en' ? 'Play video' : 'Video abspielen' %>" data-video-label="<%= lang === 'en' ? 'Apartment video' : 'Video der Wohnung' %>">
        <% const slideCount = (video ? 1 : 0) + photos.length; %>
        <div class="apartment-hero">
          <div class="apartment-stage" id="apartmentStage">
            <% if (video && video.kind === 'file') { %>
              <video id="apartmentVideo" controls playsinline src="<%= video.url %>"></video>
              <button class="video-play-overlay" type="button" aria-label="<%= lang === 'en' ? 'Play video' : 'Video abspielen' %>">
                <svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
                  <circle cx="32" cy="32" r="31" fill="rgba(0,0,0,0.6)" stroke="white" stroke-width="2" />
                  <polygon points="26,20 26,44 46,32" fill="white" />
                </svg>
              </button>
            <% } else if (video && video.embed) { %>
              <iframe src="<%= video.embed %>" title="<%= lang === 'en' ? 'Apartment video' : 'Video der Wohnung' %>" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
            <% } else if (video) { %>
              <a class="apartment-video-link" href="<%= video.url %>" target="_blank" rel="noopener"><%= lang === 'en' ? 'Watch the video' : 'Video ansehen' %></a>
            <% } else if (photos.length) { %>
              <img id="apartment-hero" src="<%= photos[0] %>" alt="<%= rental.title %>">
            <% } %>
          </div>
          <% if (slideCount > 1) { %>
            <button type="button" class="gallery-nav prev" id="apartmentPrev" aria-label="<%= lang === 'en' ? 'Previous' : 'Zurück' %>">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="15,18 9,12 15,6"></polyline>
              </svg>
            </button>
            <button type="button" class="gallery-nav next" id="apartmentNext" aria-label="<%= lang === 'en' ? 'Next' : 'Weiter' %>">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="9,18 15,12 9,6"></polyline>
              </svg>
            </button>
          <% } %>
        </div>
        <% if (video || photos.length > 1) { %>
          <div class="apartment-thumbs">
            <% if (video) { %>
              <button type="button" class="is-active is-video" data-kind="<%= video.kind %>" data-src="<%= video.embed || video.url %>" aria-label="<%= lang === 'en' ? 'Video' : 'Video' %>">
                <% if (photos.length) { %><img src="<%= photos[0] %>" alt=""><% } %>
                <span class="play-badge" aria-hidden="true">
                  <svg viewBox="0 0 36 36" width="28" height="28">
                    <circle cx="18" cy="18" r="17" fill="rgba(0,0,0,0.55)" stroke="white" stroke-width="1.5" />
                    <polygon points="14,10 14,26 26,18" fill="white" />
                  </svg>
                </span>
              </button>
            <% } %>
            <% photos.forEach(function (photo, index) { %>
              <button type="button" class="<%= !video && index === 0 ? 'is-active' : '' %>" data-kind="photo" data-src="<%= photo %>" aria-label="<%= lang === 'en' ? 'Photo ' + (index + 1) : 'Foto ' + (index + 1) %>">
                <img src="<%= photo %>" alt="">
              </button>
            <% }) %>
          </div>
        <% } %>
      </div>
      <div class="apartment-copy">
        <h1><%= rental.title %></h1>
        <p class="apartment-place"><%= rental.neighborhood || 'Berlin' %><% if (rental.neighborhood) { %>, Berlin<% } %></p>
        <p class="apartment-rent"><%= rental.rentLabel %> <span><%= lang === 'en' ? 'per month' : 'pro Monat' %></span></p>
        <section class="apartment-details" aria-labelledby="apartment-details-title">
          <h2 id="apartment-details-title"><%= lang === 'en' ? 'Apartment details' : 'Angaben zur Wohnung' %></h2>
          <dl class="apartment-details-grid">
            <% if (rental.sizeLabel) { %>
              <div><dt><%= lang === 'en' ? 'Size' : 'Wohnfläche' %></dt><dd><%= rental.sizeLabel %></dd></div>
            <% } %>
            <% if (rental.roomsValue) { %>
              <div><dt><%= lang === 'en' ? 'Rooms' : 'Zimmer' %></dt><dd><%= rental.roomsValue %></dd></div>
            <% } %>
            <% if (rental.floorValue) { %>
              <div><dt><%= lang === 'en' ? 'Floor' : 'Etage' %></dt><dd><%= rental.floorValue %></dd></div>
            <% } %>
            <% if (rental.stayLabel) { %>
              <div><dt><%= lang === 'en' ? 'Length of stay' : 'Mietdauer' %></dt><dd><%= rental.stayLabel %></dd></div>
            <% } %>
            <% if (rental.depositLabel) { %>
              <div><dt><%= lang === 'en' ? 'Deposit' : 'Kaution' %></dt><dd><%= rental.depositLabel %></dd></div>
            <% } %>
            <% if (rental.availableLabel) { %>
              <div><dt><%= lang === 'en' ? 'Available from' : 'Einzug ab' %></dt><dd><%= rental.availableLabel %></dd></div>
            <% } %>
            <% if (rental.utilitiesValue) { %>
              <div><dt><%= lang === 'en' ? 'Utilities' : 'Nebenkosten' %></dt><dd><%= rental.utilitiesValue %></dd></div>
            <% } %>
          </dl>
          <% if (rental.note) { %><p class="apartment-note"><%= rental.note %></p><% } %>
        </section>
        <% if (description) { %>
          <section class="apartment-description">
            <h2><%= lang === 'en' ? 'Description' : 'Beschreibung' %></h2>
            <p><%= description %></p>
          </section>
        <% } %>
      </div>
    </div>
    <aside class="apartment-inquiry" id="inquiry">
      <h2><%= lang === 'en' ? 'Send inquiry' : 'Anfrage senden' %></h2>
      <p><%= lang === 'en'
        ? 'Tell us when you would like to move in. This is a request, not a booking.'
        : 'Schreiben Sie uns, wann Sie einziehen möchten. Das ist eine Anfrage, keine Buchung.' %></p>
      <% if (formError) { %><p class="catalogue-error"><%= formError %></p><% } %>
      <form method="post" action="<%= rental.href %>" <% if (process.env.RECAPTCHA_SITE_KEY) { %> data-recaptcha-site-key="<%= process.env.RECAPTCHA_SITE_KEY %>" <% } %>>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (process.env.RECAPTCHA_SITE_KEY) { %>
          <input type="hidden" name="recaptchaToken" id="rentalRecaptchaToken">
        <% } %>
        <input type="text" name="hp_field" tabindex="-1" autocomplete="off" style="position:absolute; left:-10000px; top:auto; width:1px; height:1px; overflow:hidden;" aria-hidden="true">
        <label><%= lang === 'en' ? 'Name' : 'Name' %>
          <input name="name" required maxlength="100" value="<%= form.name %>">
        </label>
        <label><%= lang === 'en' ? 'Email' : 'E-Mail' %>
          <input type="email" name="email" required maxlength="200" value="<%= form.email %>">
        </label>
        <div class="apartment-phone">
          <label><%= lang === 'en' ? 'Code' : 'Vorwahl' %>
            <input name="countryCode" required maxlength="8" value="<%= form.countryCode || '+49' %>">
          </label>
          <label><%= lang === 'en' ? 'Phone' : 'Telefon' %>
            <input name="phone" required maxlength="30" value="<%= form.phone %>">
          </label>
        </div>
        <div class="apartment-optional">
          <label><%= lang === 'en' ? 'Move-in' : 'Einzug' %>
            <input type="date" name="moveIn" value="<%= form.moveIn %>">
          </label>
          <label><%= lang === 'en' ? 'Months' : 'Monate' %>
            <input type="number" name="stay" min="1" max="36" value="<%= form.stay %>">
          </label>
          <label><%= lang === 'en' ? 'People' : 'Personen' %>
            <input type="number" name="people" min="1" max="12" value="<%= form.people %>">
          </label>
        </div>
        <label><%= lang === 'en' ? 'Message' : 'Nachricht' %>
          <textarea name="message" required minlength="10" maxlength="2000"><%= form.message %></textarea>
        </label>
        <button type="submit" class="btn btn-primary catalogue-cta"><%= lang === 'en' ? 'Send inquiry' : 'Anfrage senden' %></button>
      </form>
    </aside>
  </div>
</section>
<% if (process.env.RECAPTCHA_SITE_KEY) { %>
  <script src="https://www.google.com/recaptcha/api.js?render=<%= process.env.RECAPTCHA_SITE_KEY %>"></script>
<% } %>
<script>
(function () {
  var gallery = document.querySelector('.apartment-gallery');
  var stage = document.getElementById('apartmentStage');
  var thumbs = Array.prototype.slice.call(document.querySelectorAll('.apartment-thumbs button'));
  var index = 0;
  var title = gallery ? gallery.getAttribute('data-title') || '' : '';
  var watchLabel = gallery ? gallery.getAttribute('data-watch') || 'Watch the video' : 'Watch the video';
  var playLabel = gallery ? gallery.getAttribute('data-play') || 'Play video' : 'Play video';
  var videoLabel = gallery ? gallery.getAttribute('data-video-label') || 'Apartment video' : 'Apartment video';
  function playBadge() {
    return '<svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true"><circle cx="32" cy="32" r="31" fill="rgba(0,0,0,0.6)" stroke="white" stroke-width="2" /><polygon points="26,20 26,44 46,32" fill="white" /></svg>';
  }
  function bindPlayOverlay() {
    if (!stage) return;
    var media = stage.querySelector('video');
    var overlay = stage.querySelector('.video-play-overlay');
    if (!media || !overlay || overlay.dataset.bound === '1') return;
    overlay.dataset.bound = '1';
    var sync = function () { overlay.style.display = media.paused ? 'flex' : 'none'; };
    sync();
    media.addEventListener('play', sync);
    media.addEventListener('pause', sync);
    media.addEventListener('ended', sync);
    overlay.addEventListener('click', function () { media.play(); });
  }
  function showPhoto(nextIndex) {
    if (!stage || !thumbs.length) return;
    var next = (nextIndex + thumbs.length) % thumbs.length;
    if (next === index && stage.childElementCount) return;
    index = next;
    var slide = thumbs[index];
    var kind = slide.getAttribute('data-kind') || 'photo';
    var src = slide.getAttribute('data-src') || '';
    stage.innerHTML = '';
    if (kind === 'photo') {
      var img = document.createElement('img');
      img.id = 'apartment-hero';
      img.src = src;
      img.alt = title;
      stage.appendChild(img);
    } else if (kind === 'file') {
      var media = document.createElement('video');
      media.id = 'apartmentVideo';
      media.controls = true;
      media.playsInline = true;
      media.src = src;
      stage.appendChild(media);
      var overlay = document.createElement('button');
      overlay.className = 'video-play-overlay';
      overlay.type = 'button';
      overlay.setAttribute('aria-label', playLabel);
      overlay.innerHTML = playBadge();
      stage.appendChild(overlay);
    } else if (kind === 'youtube' || kind === 'vimeo') {
      var frame = document.createElement('iframe');
      frame.src = src;
      frame.title = videoLabel;
      frame.allowFullscreen = true;
      frame.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture; fullscreen');
      stage.appendChild(frame);
    } else if (src) {
      var link = document.createElement('a');
      link.className = 'apartment-video-link';
      link.href = src;
      link.target = '_blank';
      link.rel = 'noopener';
      link.textContent = watchLabel;
      stage.appendChild(link);
    }
    thumbs.forEach(function (item, itemIndex) { item.classList.toggle('is-active', itemIndex === index); });
    if (typeof thumbs[index].scrollIntoView === 'function') {
      thumbs[index].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    }
    bindPlayOverlay();
  }
  thumbs.forEach(function (button, buttonIndex) {
    button.addEventListener('click', function () { showPhoto(buttonIndex); });
  });
  var prev = document.getElementById('apartmentPrev');
  var next = document.getElementById('apartmentNext');
  if (prev) prev.addEventListener('click', function () { showPhoto(index - 1); });
  if (next) next.addEventListener('click', function () { showPhoto(index + 1); });
  bindPlayOverlay();
  document.addEventListener('keydown', function (event) {
    if (!thumbs.length) return;
    var tag = event.target && event.target.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
    if (event.key === 'ArrowLeft') showPhoto(index - 1);
    if (event.key === 'ArrowRight') showPhoto(index + 1);
  });
  var form = document.querySelector('.apartment-inquiry form');
  if (!form) return;
  var siteKey = form.getAttribute('data-recaptcha-site-key');
  if (!siteKey) return;
  form.addEventListener('submit', function (event) {
    var token = document.getElementById('rentalRecaptchaToken');
    if (!token || token.value || !window.grecaptcha) return;
    event.preventDefault();
    window.grecaptcha.ready(function () {
      window.grecaptcha.execute(siteKey, { action: 'rental_inquiry' }).then(function (value) {
        token.value = value;
        form.submit();
      });
    });
  });
})();
</script>
